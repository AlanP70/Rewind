# Copy to backend/.env and fill in. Never commit backend/.env.

# --- Database -----------------------------------------------------------------
# Two variables, one database: the app is async (asyncpg), Alembic is sync
# (psycopg). Keeping them separate also lets production point them at different
# hosts if Alembic ever moves to the direct connection.

# Local dev — credentials match docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://rewind:rewind@localhost:5432/rewind
ALEMBIC_DATABASE_URL=postgresql+psycopg://rewind:rewind@localhost:5432/rewind

# Supabase — Settings -> Database -> Connection string -> "Session pooler".
# Same host and port for both; only the driver prefix differs.
# Session pooler rather than direct connection (IPv6-only without the IPv4
# add-on) or transaction pooler (no prepared statements, which psycopg's
# auto-prepare fights). See ROADMAP.md's deferred section.
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- OpenAI -------------------------------------------------------------------
# Needed only by the embedding step. Everything else -- the API, the health
# routes, `ingest --dry-run` -- runs without it.
#
# The working key is scoped to /v1/embeddings only. Phase 5's concept extraction
# needs chat completions and will fail with a permissions error, not a quota or
# billing error, until the key is widened or a second one is issued.
OPENAI_API_KEY=sk-proj-replace-me

# --- Storage ------------------------------------------------------------------
# Where document bytes live. `documents.storage_key` addresses them; it is a key
# into whichever backend is selected here, never a filesystem path.
#
# `local` is the default so a fresh clone can ingest and verify with no
# credentials at all. It writes under backend/.storage, which is gitignored.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=.storage

# `supabase` is what the deploy runs on: the upload endpoint and the worker are
# separate Render services with no shared disk, so a local path would work on no
# machine but the developer's. The bucket is private -- these credentials are the
# only way in.
#
# The service key goes in *both* the apikey and Authorization headers, because
# the two key formats authenticate differently: a legacy `service_role` key is a
# JWT storage-api validates itself, while a current `sb_secret_...` key is
# resolved by the API gateway from `apikey`. See app/core/storage.py.
# STORAGE_BACKEND=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=sb_secret_replace-me
# STORAGE_BUCKET=documents

# --- CORS ---------------------------------------------------------------------
# Comma-separated. Localhost placeholder until the first Vercel deploy supplies
# the real origin.
CORS_ORIGINS=http://localhost:3000
