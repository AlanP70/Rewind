# Secrets
.env
.env.local
!.env.example
!.env.local.example

# Python
__pycache__/
*.py[cod]
.venv/

# Local storage backend — uploaded document bytes, not project source.
backend/.storage/

# The eval corpus — 4.8 MB of MIT OpenCourseWare PDFs with a canonical home
# elsewhere. `backend/evals/corpus.tsv` pins the URLs and checksums; run
# `python evals/fetch_corpus.py` to get the files.
backend/evals/corpus/

# Cached query embeddings for `python -m app.cli eval` — 16 vectors, derivable
# from `evals/questions.tsv` and an API key. Cached so a re-run cannot quietly
# re-embed and move a number that is being compared against a previous run.
backend/evals/.query_cache.json

# Node
node_modules/
.next/

# Editors / OS
.DS_Store

# Agent tooling — local state, not project source
.claude/
.tokensave/
